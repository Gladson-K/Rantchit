# PostgreSQL Database
POSTGRES_USER=rantchit
POSTGRES_PASSWORD=change_me_super_secret_db_password
POSTGRES_DB=rantchit

# Security Key
SECRET_KEY=please_change_me_to_a_long_random_string_64_bytes_for_hmac_hashing

# Domain for Caddy & Reverse Proxy
DOMAIN=localhost

# Allowed CORS Origins (comma-separated or wildcard)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:80,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1,https://app.rantchit.example

# Room Lifecycle Settings
ROOM_DEFAULT_TTL_MINUTES=60
ROOM_MAX_TTL_MINUTES=1440
MESSAGE_MAX_BYTES=16384
RATE_LIMIT_CREATE_PER_HOUR=100
RATE_LIMIT_MESSAGES_PER_MINUTE=120
WS_HEARTBEAT_SECONDS=30
LOG_LEVEL=INFO
